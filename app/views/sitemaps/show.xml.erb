<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<% @urls.each do |loc| %>
  <url>
    <loc><%= loc %></loc>
    <changefreq><%= loc.include?("/c/") ? "daily" : "weekly" %></changefreq>
    <priority><%= if loc.end_with?("himrate.com/")
                    "1.0"
                  elsif loc.include?("/c/")
                    "0.6"
                  else
                    "0.8"
                  end %></priority>
  </url>
<% end %>
</urlset>

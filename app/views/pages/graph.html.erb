<%# W5 «Паутинка» — интерактивный граф пересечения аудиторий (chat-presence basis, T1-057).
    Нет Pencil-экспорта: страница собрана вручную в языке дизайна ЛК (тёмная палитра, Inter/Geist).
    Реальные данные + интерактив — landing/graph.js (canvas force-layout, без внешних библиотек). %>
<div data-pencil-name="Screen · Паутинка" class="box-border w-full min-h-screen flex flex-col bg-[#0B0B12]">
  <div class="box-border w-full h-fit flex flex-row gap-[12px] p-[20px_24px] justify-between items-center [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#25252F]">
    <div class="box-border w-fit h-fit flex flex-col gap-[4px]">
      <div class="text-[18px]/[normal] text-[#F4F4F7] font-[Inter,system-ui,sans-serif] font-bold">Паутинка аудиторий</div>
      <div id="hr-graph-sub" class="text-[12.5px]/[normal] text-[#9A9AA9] font-[Inter,system-ui,sans-serif]">
        Общие чаттеры между каналами · основа: активность в чатах
      </div>
    </div>
    <div class="box-border w-fit h-fit flex flex-row gap-[10px] items-center">
      <input id="hr-graph-focus" type="text" placeholder="Фокус: логин канала…"

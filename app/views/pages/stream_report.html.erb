<%# WEB-CONSOLIDATION §8 — one broadcast, taken apart.

    No Pencil export exists for this screen, so it is built by hand in the card's design language
    (the /graph precedent). The server renders a shell with the facts it already holds — which
    channel, which broadcast, when — so the page is meaningful before any JavaScript runs; the
    series, the anomalies and the raids are filled in by landing/stream_report.js from
    GET /api/v1/channels/:login/streams/:stream_id/report.

    Not indexed: one page per broadcast is crawl noise, and the channel card is what should rank. %>
<% content_for :title, "Эфир #{@channel_name} — #{@stream.started_at.strftime('%d.%m.%Y')} · HimRate" %>
<% content_for :description, "Разбор одного эфира канала #{@channel_name}: как менялся онлайн, что происходило, сколько зрителей было реальными." %>
<% content_for :canonical, "#{canonical_host}/c/#{@login}" %>
<% content_for :robots, "noindex, follow" %>

<div class="box-border w-full min-h-screen flex flex-col bg-[#0B0B0F]">
  <div
    data-pencil-name="Content"
    class="box-border w-full max-w-[980px] mx-auto flex flex-col gap-[22px] p-[26px_20px_60px_20px] justify-start items-start"
  >
    <div data-pencil-name="Breadcrumb" class="box-border w-full flex flex-row gap-[7px] items-center">
      <a href="/" class="text-[#9A9AA9] text-[13px] no-underline">Главная</a>
      <span class="text-[#3A3A46] text-[13px]">/</span>
      <a href="/c/<%= @login %>" class="text-[#9A9AA9] text-[13px] no-underline"><%= @channel_name %></a>
      <span class="text-[#3A3A46] text-[13px]">/</span>
      <span class="text-[#C9C9D1] text-[13px]">эфир</span>
    </div>

    <div
      data-pencil-name="SR Head"
      class="box-border w-full flex flex-col gap-[10px] p-[28px] bg-[#141419] [border:1px_solid_#25252F] rounded-[20px]"
    >
      <h1 class="m-0 text-[#F4F4F6] text-[22px] font-semibold">Эфир <%= @channel_name %></h1>
      <div data-pencil-name="SR Meta" class="text-[#9A9AA9] text-[13.5px]">
        <%= @stream.started_at.strftime("%d.%m.%Y, %H:%M") %><%= " · #{@stream.game_name}" if @stream.game_name.present? %>
      </div>
      <div data-pencil-name="SR Verdict" class="text-[#9A9AA9] text-[14px]">Загружаем разбор…</div>
    </div>
  </div>
</div>
